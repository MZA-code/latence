# LATENCE · https://latence-game.com (o2switch, Apache)
# Copié tel quel dans dist/ par Vite (public/) : déposer le contenu de dist/ à la racine du site.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------- Robots d'IA et aspirateurs : refusés (robots.txt reste lisible)
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|Claude-Web|anthropic-ai|CCBot|PerplexityBot|Perplexity-User|Bytespider|Amazonbot|meta-externalagent|meta-externalfetcher|FacebookBot|cohere-ai|cohere-training|Diffbot|ImagesiftBot|Omgili|Timpibot|YouBot|AI2Bot|Ai2Bot-Dolma|DuckAssistBot|MistralAI-User|PanguBot|Kangaroo\ Bot|Webzio-Extended|img2dataset|Scrapy|AhrefsBot|SemrushBot|MJ12bot|DotBot|BLEXBot|DataForSeoBot|serpstatbot|Barkrowler|MegaIndex|ZoominfoBot|PetalBot|python-requests|python-urllib|aiohttp|Go-http-client|libwww-perl|HTTrack|wget) [NC]
  RewriteRule ^ - [F,L]

  # ---------- Une seule adresse : https://latence-game.com, sans www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://latence-game.com%{REQUEST_URI} [R=301,L,NE]

  # index.html n'a pas d'adresse à lui : la racine
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Fichiers cachés (sauf .well-known) : introuvables
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # ---------- Sécurité : tout vient du site lui-même, rien d'autre
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Robots-Tag "noai, noimageai"
  Header unset X-Powered-By

  # ---------- Cache : les fichiers de assets/ portent une empreinte, ils ne changent jamais
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(svg|png|jpg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
